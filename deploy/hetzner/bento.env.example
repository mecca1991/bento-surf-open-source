# Worker env for the Hetzner deployment. Lives ONLY on the VM at
# $BENTO_HOME/secrets/bento.env (mode 600, owned by `deploy`). It is used twice:
#   1. as `.env` during `docker build` so the VITE_* values are inlined, and
#   2. copied to `.dev.vars` at container start so Wrangler injects every key
#      into the worker's `env` (and, via nodejs_compat, process.env).
# `init-secrets.sh` renders it from this template. Anything marked
# __CARRY_OVER__ must be copied from the laptop's .env by hand (same value, or
# the data restored from the dump cannot be decrypted / signed in).
# See ../../.env.example and docs/configuration.md for every optional key.

# --- Instance ---------------------------------------------------------------
APP_ENV=production
BENTO_EDITION=self_hosted
VITE_APP_ENV=production
VITE_APP_NAME=Bento Surf
VITE_APP_URL=https://__PUBLIC_HOST__
VITE_PUBLIC_URL=https://__PUBLIC_HOST__
VITE_PREVIEW_IMAGE_URL=
VITE_SUPPORT_EMAIL=
VITE_PRIVACY_URL=
VITE_TERMS_URL=
VITE_SOURCE_URL=https://github.com/bizibeast/bento-surf-open-source
FOUNDER_ADMIN_EMAILS=

# --- Supabase (self-hosted trio behind bento_gateway) ------------------------
# Server-side calls stay inside shared_network; the browser uses the public
# path, which nginx forwards to the same gateway. Both stay within the CSP's
# connect-src 'self'.
SUPABASE_PROJECT_ID=bento-hetzner
SUPABASE_URL=http://bento_gateway:8000
SUPABASE_PUBLISHABLE_KEY=__ANON_KEY__
SUPABASE_SERVICE_ROLE_KEY=__SERVICE_ROLE_KEY__
# Only for scripts/migrate-supabase.ts --local, run ON the VM with APP_ENV=development.
SUPABASE_DB_URL=postgresql://postgres:__PG_PASSWORD__@127.0.0.1:54322/postgres
DATABASE_URL=
MIGRATION_CONFIRMATION=
PRODUCTION_SUPABASE_PROJECT_ID=bento-hetzner
VITE_SUPABASE_PROJECT_ID=bento-hetzner
VITE_SUPABASE_URL=https://__PUBLIC_HOST__/supabase
VITE_SUPABASE_PUBLISHABLE_KEY=__ANON_KEY__

# --- Application secrets (fresh, generated on the VM) ------------------------
REFERRAL_HASH_SECRET=__RANDOM__
REFERRAL_COOKIE_DOMAIN=
PAYMENT_CONNECTION_ENCRYPTION_KEY=__RANDOM__
BOOKING_CONNECTION_ENCRYPTION_KEY=__RANDOM__
CONTENT_CONNECTION_ENCRYPTION_KEY=__RANDOM__
WORKSPACE_COOKIE_SIGNING_KEY=__RANDOM__
HEALTH_CHECK_TOKEN=__RANDOM__
EMAIL_SIGNING_SECRET=__RANDOM__
# Gate for the /__scheduled cron trigger; same value as in compose.env.
BENTO_CRON_TOKEN=__CRON_TOKEN__
WEBMCP_ORIGIN_TRIAL_TOKEN=
WEBMCP_APP_ORIGIN_TRIAL_TOKEN=
WEBMCP_PUBLIC_ORIGIN_TRIAL_TOKEN=

# --- Carried over from the laptop .env (SAME values) -------------------------
# Decrypts the stored Facebook Page/user tokens in social_connections.
SOCIAL_CONNECTION_ENCRYPTION_KEY=__CARRY_OVER__
META_GRAPH_API_VERSION=v25.0
META_FACEBOOK_APP_ID=__CARRY_OVER__
META_FACEBOOK_APP_SECRET=__CARRY_OVER__
META_FACEBOOK_PUBLISHING_ONLY=true
META_FACEBOOK_ACCESS_LEVEL=
META_INSTAGRAM_REDIRECT_URI=https://__PUBLIC_HOST__/integrations/instagram/callback

# --- Feature switches (pilot defaults; mirror wrangler.server.jsonc vars) -----
COMMERCE_PAYMENT_PROVIDER=disabled
DODO_PAYMENTS_ENVIRONMENT=test_mode
PAYPAL_ENVIRONMENT=sandbox
POLAR_ENVIRONMENT=sandbox
RAZORPAY_ROUTE_ENABLED=false
CUSTOM_DOMAINS_ENABLED=false
EMAIL_DELIVERY_MODE=disabled
SOCIAL_PROVIDER_MODE=live
CONTENT_AGENT_PROACTIVE_ENABLED=false
CONTENT_AGENT_IMAGES_ENABLED=false
CONTENT_AGENT_REFERENCE_VISION_ENABLED=false
X_PAID_READS_ENABLED=false
X_ACCOUNT_ACTIVITY_ENABLED=false
X_WEBHOOK_STAGING_APP_ISOLATED=false
VITE_FEATUREBASE_IDENTIFY_ENABLED=false

# --- Optional providers (empty = feature unavailable, never simulated) -------
GROQ_API_KEY=
GROQ_TEXT_MODEL=
OPENROUTER_API_KEY=
PIXABAY_API_KEY=
PEXELS_API_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=
