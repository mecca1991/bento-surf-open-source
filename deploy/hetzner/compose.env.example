# Infrastructure env for deploy/hetzner/docker-compose.yml (compose interpolation).
# Lives ONLY on the VM at $BENTO_HOME/secrets/compose.env, mode 600, owned by
# `deploy`. `init-secrets.sh` writes it; this file documents the contract.
# These values feed Postgres, GoTrue, PostgREST and the gateway. The worker's
# own env is the separate bento.env (template: bento.env.example).

BENTO_HOME=/opt/bento
BENTO_PUBLIC_HOST=bento.wilfredchetat.com

# Postgres password shared by the Supabase roles (postgres, authenticator,
# supabase_auth_admin, ...), exactly like the Supabase CLI's local stack.
BENTO_PG_PASSWORD=

# HS256 secret GoTrue signs with and PostgREST verifies. The anon/service_role
# keys below are JWTs minted from it (init-secrets.sh does this). NEVER reuse the
# Supabase CLI's well-known demo secret from the laptop.
BENTO_JWT_SECRET=
BENTO_SUPABASE_ANON_KEY=
BENTO_SUPABASE_SERVICE_ROLE_KEY=

# Shared secret between the bento_cron sidecar and the worker's /__scheduled
# route (deploy/hetzner/vm-entry.mjs). Must equal BENTO_CRON_TOKEN in bento.env.
BENTO_CRON_TOKEN=

# "false" for the first boot (lets the restored account be checked), then "true":
# this instance is public and has exactly one operator account.
BENTO_AUTH_DISABLE_SIGNUP=false

# Optional SMTP relay for GoTrue (password recovery / invites). Leave empty to
# keep mail disabled; accounts are auto-confirmed either way.
BENTO_SMTP_HOST=
BENTO_SMTP_PORT=587
BENTO_SMTP_USER=
BENTO_SMTP_PASS=
BENTO_SMTP_ADMIN_EMAIL=

# wrangler dev log level inside bento_app: info | log | warn | error | debug
BENTO_WRANGLER_LOG_LEVEL=info

# Off-host copy of backup.sh output (optional; empty bucket = local only).
# Credentials come from ~/.aws/credentials of the user running backup.sh.
# Same R2 bucket/endpoint as server-infra's shared postgres backups.
BENTO_BACKUP_S3_BUCKET=
BENTO_BACKUP_S3_PREFIX=backups/bento
BENTO_BACKUP_S3_ENDPOINT=
BENTO_BACKUP_AWS_REGION=auto
